# Copia este archivo como .env.local y llena los datos de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK).
# En Netlify se ponen los mismos nombres en Site settings → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
